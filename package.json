{
  "name": "uzbek-avatar",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "concurrently \"npm run dev:server\" \"npm run dev:client\"",
    "dev:client": "vite",
    "dev:server": "node --watch --use-system-ca server/index.js",
    "build": "vite build",
    "lint": "eslint .",
    "preview": "vite preview",
    "index": "node --use-system-ca server/index-knowledge.js",
    "index:legacy": "node --use-system-ca server/index-knowledge-legacy.js",
    "models": "node server/list-models.js",
    "start": "node --use-system-ca server/index.js",
    "eval:rag": "node --use-system-ca server/eval/evaluate-rag.js",
    "eval:rag:check": "node server/eval/evaluate-rag.js --check",
    "eval:rag:hard": "node --use-system-ca server/eval/evaluate-rag.js --questions rag-questions-hard.json",
    "eval:rag:check:hard": "node server/eval/evaluate-rag.js --check --questions rag-questions-hard.json",
    "eval:rag:compare": "node server/eval/compare-rag.js",
    "eval:grounding": "node --use-system-ca server/eval/evaluate-grounding.js",
    "eval:grounding:judge": "node --use-system-ca server/eval/judge-grounding.js",
    "eval:grounding:compare": "node server/eval/compare-grounding.js"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.112.4",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "react-router-dom": "^7.18.2"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.1",
    "concurrently": "^9.1.2",
    "eslint": "^10.3.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "globals": "^17.6.0",
    "vite": "^8.0.12"
  }
}
