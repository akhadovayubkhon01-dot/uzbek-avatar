# Copy this file to .env and fill in the values. Never commit .env.

# ── Server ──────────────────────────────────────────────
# Gemini API key (kept on the server, never sent to the browser).
# Get one at https://aistudio.google.com/apikey
# Without it the app runs in demo mode with prewritten answers.
GEMINI_API_KEY=
PORT=3001

# Optional: override the Gemini models
# GEMINI_MODEL=gemini-3.5-flash
# GEMINI_FALLBACK_MODEL=gemini-3.5-flash-lite
# GEMINI_EMBED_MODEL=gemini-embedding-001

# Optional: how retrieved sources are presented to the model
# (baseline = default, strict = experimental grounding prompt)
# RAG_GROUNDING=baseline

# ── Frontend (sign-in and chat history) ─────────────────
# From your Supabase project: Settings → API.
# The anon key is public by design; access is limited by row-level security.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
